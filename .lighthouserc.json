{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-results"
    }
  }
}